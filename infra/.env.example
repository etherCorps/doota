# Deploy-time environment for infra/alchemy.run.ts.
# Copy to infra/.env (gitignored) and fill in. Shell-exported vars override
# these. In CI, set them as repository secrets/variables instead of a file.
#
# The contract, in one line: two deployment credentials (CI only), four values
# required from the deployer for a working mail instance, everything else
# minted automatically or optional.
#
# IMPORTANT (production): Alchemy replaces each Worker's ENTIRE binding set on
# deploy. Every secret that is live on a production Worker must be present
# here (or in the shell) when deploying --stage production, or it is wiped —
# for an EXISTING deployment, provide the live values; auto-minting is for
# fresh setups only.

# ── 1. Deployment credentials (CI/headless only) ────────────────────────────
# Local deploys use `pnpm alchemy login` (browser OAuth) instead — these are
# for CI or token-based local deploys. Scopes: see infra/README.md.
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=

# ── 2. Required from the deployer ───────────────────────────────────────────
# The stack deploys without these, but each absence disables something
# essential — set all four for a working mail instance.

# Serving origins: comma-separated FULL URLs with protocol, e.g.
#   ORIGINS=https://mail.example.com, https://mail.other.org
# First entry is the canonical app URL; every entry is attached to the web
# Worker as a Cloudflare custom domain (zones must exist in your account) and
# trusted by auth as an allowed host. Unset → workers.dev only.
ORIGINS=

# Any string you choose — gates the one-time /setup genesis wizard. You must
# know it to create the first admin. Unset → wizard disabled.
SETUP_TOKEN=

# Cloudflare account id + SCOPED API token the RUNNING APP uses for domain
# onboarding (zones, Email Routing, DNS, DKIM). Never the Global API Key, and
# NOT the deploy token above — different scopes (docs: two Cloudflare tokens).
# Unset → domain onboarding disabled: no real mail.
APP_CLOUDFLARE_ACCOUNT_ID=
APP_CLOUDFLARE_API_TOKEN=

# ── 3. Auto-minted — leave blank ────────────────────────────────────────────
# Minted ONCE into the Alchemy state store on the first deploy; every later
# deploy (local or CI) reuses the same value. Provide your own only to keep a
# copy in your vault — the deploy output's secretSources shows env vs state.
#
# MAIL_DEK: AES-256-GCM key for all mail content (manual: openssl rand -base64 32)
#MAIL_DEK=
# MAIL_SEARCH_KEY: blind-search + signed-token HMAC key (same manual form)
#MAIL_SEARCH_KEY=
# BETTER_AUTH_SECRET: session signing secret
#BETTER_AUTH_SECRET=
# VAPID web-push keypair — minted as a pair; setting only one half is an
# error (manual: node scripts/gen-vapid-keys.mjs at the repo root)
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=

# ── 4. Optional ─────────────────────────────────────────────────────────────
# Bearer secret for POST /api/cron (HTTP-triggered maintenance sweeps).
#CRON_SECRET=
# Override for the {{ unsubscribe_url }} template variable path.
#UNSUBSCRIBE_URL=
# Mail-pipeline log level: debug|info|warn|error (default info).
#LOG_LEVEL=
